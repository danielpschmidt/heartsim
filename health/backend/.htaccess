# Zugangsdaten, SQL-Dateien (Schema/Migrationen) und Beispiel-Config nie öffentlich ausliefern.
<FilesMatch "^(config\.php|config\.example\.php)$|\.sql$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

Options -Indexes

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set Referrer-Policy "same-origin"
</IfModule>
